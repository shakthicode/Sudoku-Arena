# Normalize line endings for cross-platform collaboration
* text=auto

# Always use LF for source files
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# Windows scripts keep CRLF
*.bat   text eol=crlf

# Binary files — no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.pdf   binary
